local function waitForResponse(before, job, started, delay)
    local originalFingerprint = fingerprint(before, job.kind)
    local lastWaitingStatus = -math.huge
    local dataMissing = false
    while not closed and not teleporting and activeJob == job do
        if job.cancelled and not pendingRollback then return nil, "Stopped." end
        local elapsed = os.clock() - started
        -- The delay starts at FireServer, overlapping the server response.
        -- Check for the result once it expires, without a second quiet-period wait.
        if elapsed >= delay then
            local current = readBuild()
            dataMissing = current.yen == nil or not ready(current, job.kind)
            if current.yen ~= nil and ready(current, job.kind) then
                local resultChanged = fingerprint(current, job.kind) ~= originalFingerprint or current.nodes[job.kind] ~= before.nodes[job.kind]
                local yenChanged = current.yen ~= before.yen
                -- Wait for the debit as well, so the next yen-floor check uses
                -- the updated balance. An unchanged result still needs grace:
                -- a debit alone can precede a late result with the same name.
                local sameResultReady = elapsed >= math.max(CONFIG.SameResultGrace, delay * 4)
                if yenChanged and (resultChanged or sameResultReady) then return current end
            end
        end
        if elapsed >= CONFIG.ResponseTimeout then
            if job.kind ~= "Color" and not dataMissing then return nil, "No confirmed roll update. Paused without sending another request." end
            if os.clock() - lastWaitingStatus >= 2 then
                setStatus("Waiting for the pending " .. job.kind .. " roll/build/yen update; retrying reads. Stop cancels.")
                lastWaitingStatus = os.clock()
            end
        end
        task.wait(0.01)
    end
    return nil, "Stopped."
end
