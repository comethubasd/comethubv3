rejoin = function(reason, continuation)
    if closed or teleporting then return end
    if activeJob then activeJob.cancelled = true end
    teleporting = true
    closeDropdown()
    setStatus(reason .. ". Rejoining...")
    task.spawn(function()
        task.wait(CONFIG.RejoinDelay)
        if closed then return end
        local state = continuation or captureSettings(nil)
        local queueOK, queued, problem = pcall(queueContinuation, state)
        if not queueOK then problem, queued = queued, false end
        if queued then
            setStatus(state.resumeKind and "Settings saved; rejoining and resuming " .. state.resumeKind .. "..." or "Settings saved; rejoining with rerolls stopped...")
        else
            warn("LOCKED auto resume: " .. tostring(problem))
            setStatus(tostring(problem) .. " Rejoining without auto resume.")
        end
        local ok, err = pcall(function()
            if game.JobId ~= "" then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
            else TeleportService:Teleport(game.PlaceId, player) end
        end)
        if not ok and not closed then
            teleporting = false
            setStatus("Rejoin failed: " .. tostring(err) .. ". Rerolls remain stopped.")
        end
    end)
end
