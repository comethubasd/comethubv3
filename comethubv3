handle("TopRight", UDim2.new(1, -cornerHitbox, 0, 0), UDim2.fromOffset(cornerHitbox, cornerHitbox), "RT", 21)
handle("BottomLeft", UDim2.new(0, 0, 1, -cornerHitbox), UDim2.fromOffset(cornerHitbox, cornerHitbox), "LB", 21)
handle("BottomRight", UDim2.new(1, -cornerHitbox, 1, -cornerHitbox), UDim2.fromOffset(cornerHitbox, cornerHitbox), "RB", 21)
local function resizeAxis(pos, size, delta, leading, trailing, minimum, maximum, screen)
    if leading then
        local far = pos + size
        local near = math.clamp(pos + delta, math.max(0, far - maximum), far - math.min(minimum, far))
        return math.floor(near), math.floor(far - near)
    elseif trailing then
        local available = math.min(maximum, screen - pos)
        return pos, math.floor(math.clamp(size + delta, math.min(minimum, available), available))
    end
    return pos, size
end
connect(UIS.InputChanged, function(input)
    if closed or not mode then return end
    if pointer then if input ~= pointer then return end
    elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local delta, screen = input.Position - startPoint, root.AbsoluteSize
    local x, y, w, h = startPosition.X.Offset, startPosition.Y.Offset, startSize.X.Offset, startSize.Y.Offset
    if mode == "move" then
        window.Position = UDim2.fromOffset(math.clamp(x + delta.X, 0, math.max(0, screen.X - w)), math.clamp(y + delta.Y, 0, math.max(0, screen.Y - h)))
    else
        x, w = resizeAxis(x, w, delta.X, mode:find("L"), mode:find("R"), CONFIG.MinWidth, CONFIG.MaxWidth, screen.X)
        y, h = resizeAxis(y, h, delta.Y, mode:find("T"), mode:find("B"), CONFIG.MinHeight, CONFIG.MaxHeight, screen.Y)
        window.Position, window.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
    end
end)
connect(UIS.InputEnded, function(input)
    if (pointer and input == pointer) or (not pointer and input.UserInputType == Enum.UserInputType.MouseButton1) then mode, pointer = nil, nil end
end)
