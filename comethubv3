-- Returns channel-wise tolerance, not lexicographic ordering of a hex string.
local function colorMatches(actual, desired, tolerance, direction)
    if not actual then return false end
    for i = 1, 3 do
        local delta = actual[i] - desired[i]
        if direction == "Under" then
            if delta > 0.00001 or delta < -tolerance - 0.00001 then return false end
        elseif direction == "Over" then
            if delta < -0.00001 or delta > tolerance + 0.00001 then return false end
        elseif math.abs(delta) > tolerance + 0.00001 then return false end
    end
    return true
end
local function matches(build, job)
    if job.kind == "Buff" then
        local actual = type(build.buffName) == "string" and build.buffName:match("^%s*(.-)%s*$") or ""
        local desired = job.buffTarget or "speed"
        return string.lower(actual) == string.lower(desired) and build.Buff ~= nil and build.Buff + 0.00001 >= job.minimum
    end
    if job.kind == "Color" then return colorMatches(build.Color, job.rgb, job.tolerance, job.direction) end
    if job.kind == "Face" then
        return build.Face == job.target or (job.faceTexture ~= nil and build.faceTexture == job.faceTexture)
    end
    return build[job.kind] ~= nil and build[job.kind] == job.target
end
local function ready(build, kind)
    if kind == "Face" then return build.faceTexture ~= nil and build.faceTexture ~= "" end
    return build[kind] ~= nil
end
local function fingerprint(build, kind)
    if kind == "Color" then
        return build.Color and string.format("%.6f|%.6f|%.6f", build.Color[1], build.Color[2], build.Color[3]) or "?"
    elseif kind == "Face" then return tostring(build.faceTexture) end
    return tostring(build[kind]) .. (kind == "Buff" and "|" .. tostring(build.buffName) or "")
end
