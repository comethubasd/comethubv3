    live.Percent.Text = "Buff %: " .. (build.Buff and string.format("%.1f%%", build.Buff) or "Loading...")
    live.Face.Text = "Face: " .. (build.Face or (build.faceTexture and "Asset " .. build.faceTexture or "Loading..."))
    if menuCategory == "Flow" then
        local percent = build.Buff and string.format("%.1f%%", build.Buff) or "..."
        local color = build.Color and string.format("#%02X%02X%02X", math.floor(build.Color[1] + 0.5), math.floor(build.Color[2] + 0.5), math.floor(build.Color[3] + 0.5)) or "..."
        buildBrief.Text = string.format("FLOW  %s     BUFF  %s / %s     RGB  %s", build.Flow or "...", build.buffName or "...", percent, color)
    elseif menuCategory == "Build" then
        buildBrief.Text = string.format("TRAIT  %s     HEIGHT  %s     FACE  %s", tostring(build.Trait or "..."), heightText(build.Height), tostring(build.Face or "..."))
    else
        buildBrief.Text = string.format("WEAPON  %s     TRAIT  %s     HEIGHT  %s", tostring(build.Weapon or "..."), tostring(build.Trait or "..."), heightText(build.Height))
