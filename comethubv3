local function waitInterruptible(job, duration)
    local untilTime = os.clock() + math.max(0, duration)
    while os.clock() < untilTime do
        if not canWork(job) then return false end
        task.wait(math.min(0.05, untilTime - os.clock()))
    end
    return canWork(job)
end
local function alive(build)
    local humanoid = build.character and build.character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end
local function sendSlot(job, targetSlot)
    slotRemote():FireServer(tostring(targetSlot or CONFIG.SlotTarget))
    job.slotSwitches = (job.slotSwitches or 0) + 1
    return os.clock()
end
local function waitForSlot(job, started, requireRefill)
    local prior, lastChange = nil, started
    local slotWait = job.kind == "Color" and 0 or CONFIG.SlotWait
    local deadline = math.max(started, os.clock()) + CONFIG.SlotTimeout
    -- Keep the worker occupied while a sent slot request is settling, even
    -- when Stop was clicked. A second worker cannot overlap that request.
    while not closed and not teleporting and activeJob == job do
        if job.kind == "Color" and job.cancelled then return nil, "Stopped." end
        local build = readBuild()
        local loaded = build.yen ~= nil and alive(build) and (job.kind == "Slot" or ready(build, job.kind))
        if loaded then
            local key = tostring(build.yen) .. "|" .. (job.kind == "Slot" and "slot" or fingerprint(build, job.kind))
            if not prior or key ~= prior.key or build.character ~= prior.character or build.nodes[job.kind] ~= prior.node then
                prior = {key = key, character = build.character, node = build.nodes[job.kind]}
                lastChange = os.clock()
            end
            local funded = not requireRefill or build.yen > job.yenFloor or matches(build, job)
            if funded and os.clock() - started >= slotWait and (job.kind == "Color" or os.clock() - lastChange >= math.max(0.2, rollDelay())) then
                return build
            end
        else
            prior, lastChange = nil, os.clock()
        end
        if os.clock() >= deadline then
            if job.kind == "Color" then
                setStatus("Waiting for slot color/yen to load or refill; retrying reads. Stop cancels.")
                deadline = os.clock() + 2
            else
                return nil, requireRefill and "Slot switch did not restore yen above the minimum. Paused." or "Character/build did not load after the slot switch. Paused."
            end
        end
        task.wait(job.kind == "Color" and 0.01 or 0.05)
    end
    return nil, "Stopped."
end
local function prepareColor(job)
    if colorPreparation.prepared then return true end
    slotRemote() -- Validate before resetting the character.
    if not colorPreparation.resetAt then
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            setStatus("Waiting for your character before the initial reset; retrying automatically...")
            while canWork(job) and (not humanoid or humanoid.Health <= 0) do
                task.wait(0.05)
                character = player.Character
                humanoid = character and character:FindFirstChildOfClass("Humanoid")
            end
            if not canWork(job) then finish(job, "Stopped."); return false end
        end
        humanoid.Health = 0
        colorPreparation.resetAt = os.clock()
    end
    if not colorPreparation.slotSentAt then
        setStatus("Preparing flow color: waiting " .. CONFIG.ResetWait .. " seconds after the initial reset before switching slots...")
        if not waitInterruptible(job, colorPreparation.resetAt + CONFIG.ResetWait - os.clock()) then finish(job, "Stopped."); return false end
        colorPreparation.slotSentAt = sendSlot(job)
    end
    setStatus("Preparing flow color: slot " .. CONFIG.SlotTarget .. " requested; waiting for the build...")
    local build, failure = waitForSlot(job, colorPreparation.slotSentAt, true)
    if not build then finish(job, failure); return false end
    colorPreparation.prepared = true
    if not canWork(job) then finish(job, "Stopped. Flow color preparation is complete."); return false end
    return true
end
