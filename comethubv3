    }, parent)
    make("UIStroke", {Color = Color3.fromRGB(34, 139, 255), Thickness = 1.5, Transparency = 0.3}, box)
    local function commit()
        local n = tonumber(box.Text)
        if not n or n ~= n or math.abs(n) == math.huge then
            box.Text = tostring(value); setStatus("Enter a valid number for " .. caption); return value
        end
        value = math.clamp(n, minimum, maximum)
        box.Text = tostring(value)
        return value
    end
    connect(box.FocusLost, commit)
    return {get = commit, box = box, set = function(n)
        if type(n) == "number" and n == n and math.abs(n) < math.huge then
            value = math.clamp(n, minimum, maximum); box.Text = tostring(value)
        end
    end}
end
