local function faceDecal(character)
    if not character then return end
    local face = character:FindFirstChild("face")
    if face and face:IsA("ObjectValue") then face = face.Value end
    if face then
        if face:IsA("Decal") then return face end
        local decal = face:FindFirstChild("Decal", true) or face:FindFirstChildWhichIsA("Decal", true)
        if decal and decal:IsA("Decal") then return decal end
    end
    local head = character:FindFirstChild("Head")
