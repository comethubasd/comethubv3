local function updatePanelShape()
    local w, h = window.AbsoluteSize.X, window.AbsoluteSize.Y
    if w <= 0 or h <= 0 then w, h = window.Size.X.Offset, window.Size.Y.Offset end
    w, h = math.floor(w), math.floor(h)
    if w <= 0 or h <= 0 then return end
    local function cut(amount) return math.floor(math.clamp(amount, 0, math.min(w, h) * 0.25)) end
    local tl, tr = cut(CONFIG.TopLeftCut), cut(CONFIG.TopRightCut)
    local bl, br = cut(CONFIG.BottomLeftCut), cut(CONFIG.BottomRightCut)
    local border = math.clamp(CONFIG.PanelOutline, 1, math.min(w, h) * 0.1)
    local diagonalBorder = border * math.sqrt(2)
    local topRows = math.ceil(math.max(math.max(tl, tr) + diagonalBorder - border + 1, border + 1))
    local bottomRows = math.ceil(math.max(math.max(bl, br) + diagonalBorder - border + 1, border + 1))
    local used = 0
    local function drawBand(y, height)
        used = used + 1
        local band = panelBand(used)
        local sampleY = y + 0.5
        local left = math.max(0, tl - sampleY, bl - (h - sampleY))
        local right = w - math.max(0, tr - sampleY, br - (h - sampleY))
        local x = math.floor(left)
        band.outer.Position = UDim2.fromOffset(x, y)
        band.outer.Size = UDim2.fromOffset(math.ceil(right) - x, height)
        band.outer.Visible = true
        local blueLeft = math.ceil(math.max(border, tl - sampleY + diagonalBorder, bl - (h - sampleY) + diagonalBorder))
        local blueRight = math.floor(w - math.max(border, tr - sampleY + diagonalBorder, br - (h - sampleY) + diagonalBorder))
        local blueY = math.max(y, math.ceil(border))
        local blueEnd = math.min(y + height, h - math.ceil(border))
        band.inner.Visible = blueRight > blueLeft and blueEnd > blueY
        if band.inner.Visible then
            band.inner.Position = UDim2.fromOffset(blueLeft - x, blueY - y)
            band.inner.Size = UDim2.fromOffset(blueRight - blueLeft, blueEnd - blueY)
            band.texture.Position = UDim2.fromOffset(-blueLeft, -blueY)
        end
    end
    -- Put the large center band first; the preload target remains this texture.
    drawBand(topRows, h - topRows - bottomRows)
    for y = 0, topRows - 1 do drawBand(y, 1) end
    for y = h - bottomRows, h - 1 do drawBand(y, 1) end
    for i = used + 1, #panelBands do panelBands[i].outer.Visible = false end
end
