local function numericInput(parent, caption, defaultValue, minimum, maximum)
    label(parent, caption, 22)
    local value = defaultValue
    local box = make("TextBox", {
        Size = UDim2.new(1, 0, 0, 30), Text = tostring(defaultValue), ClearTextOnFocus = false,
        BackgroundColor3 = Color3.fromRGB(10, 21, 36), BorderSizePixel = 0, TextSize = 21,
