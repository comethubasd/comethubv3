local function catalog(kind)
    if kind == "Height" then
        local items = {}
        for i = 1, 13 do table.insert(items, {label = heightText(i), value = i}) end
        return items
    end
    local names, seen = {}, {}
    local function add(name) if not seen[name] then seen[name] = true; table.insert(names, name) end end
    local specs = RS:FindFirstChild("Specs")
    if kind == "Weapon" then
        if specs then
            for _, obj in ipairs(specs:GetChildren()) do
                if obj:GetAttribute("type") == "weapon" or obj:GetAttribute("weapontype") ~= nil then add(obj.Name) end
            end
        end
        if #names == 0 then for _, name in ipairs(FALLBACK_WEAPONS) do add(name) end end
    elseif kind == "Trait" then
        local traits = specs and specs:FindFirstChild("Traits")
        if traits then for _, obj in ipairs(traits:GetChildren()) do add(obj.Name) end end
        if #names == 0 then for _, name in ipairs(FALLBACK_TRAITS) do add(name) end end
    elseif kind == "Flow" then
        local types = RS:FindFirstChild("FlowTypes")
        local values = types and types:FindFirstChild("FlowValues")
        if values then for _, obj in ipairs(values:GetChildren()) do add(obj.Name) end end
    elseif kind == "Face" then
        indexFaces(true)
        for name in pairs(faceTextures) do add(name) end
    end
    table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
    return namedItems(names)
end

