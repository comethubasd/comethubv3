handle("RightEdge", UDim2.new(1, -9, 0, 0), UDim2.new(0, 9, 1, 0), "R", 20)
handle("TopEdge", UDim2.fromOffset(0, 0), UDim2.new(1, 0, 0, 9), "T", 20)
