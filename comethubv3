local function updateSpatialMenu(dt)
    if closed then return end
    local anchor,camera=currentAnchor(),workspace.CurrentCamera
    local visible=anchor~=nil and camera~=nil and menuVisible and not root.Visible and not transitioning
    if anchor~=spatialAnchor then spatialAnchor,spatialYaw=anchor,nil end
    local basis
    if visible then
        local delta=camera.CFrame.Position-anchor.Position
        local flat=Vector3.new(delta.X,0,delta.Z)
        if flat.Magnitude<0.1 then
            local look=camera.CFrame.LookVector
            flat=Vector3.new(-look.X,0,-look.Z)
        end
        if flat.Magnitude<0.1 then flat=Vector3.new(0,0,1)end
        local target=CFrame.lookAt(Vector3.new(0,0,0),Vector3.new(-flat.X,0,-flat.Z))
        spatialYaw=spatialYaw and spatialYaw:Lerp(target,1-math.exp(-MENU.OrbitFollowSpeed*(dt or 1/60)))or target
        basis=CFrame.new(anchor.Position+Vector3.new(0,MENU.VerticalOffset,0))*spatialYaw
    end
    for _,entry in ipairs(ribbons)do
        if visible then
            local amount=1-math.exp(-14*(dt or 1/60))
            entry.hoverDepth=entry.hoverDepth+((entry.hovered and MENU.HoverDepth or 0)-entry.hoverDepth)*amount
            local pose=basis*entry.localFrame
            local viewingRear=(camera.CFrame.Position-pose.Position):Dot(pose.LookVector)>0
            -- Only the visible side receives input, so one click runs one action.
            entry.frontSurface.Enabled,entry.backSurface.Enabled=not viewingRear,not viewingRear
            entry.rear.surface.Enabled=viewingRear
            entry.frontPart.CanQuery,entry.backPart.CanQuery=not viewingRear,viewingRear
            entry.frontPart.CFrame=pose*CFrame.new(0,0,entry.hoverDepth)
            entry.backPart.CFrame=pose*CFrame.new(0,0,-MENU.LayerDepth-(viewingRear and entry.hoverDepth or 0))
        else
            entry.frontSurface.Enabled,entry.backSurface.Enabled,entry.rear.surface.Enabled=false,false,false
            entry.frontPart.CanQuery,entry.backPart.CanQuery=false,false
        end
    end
    statusGui.Adornee,statusGui.Enabled=anchor,visible
end
