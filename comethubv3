local function targetReached(job)
    finish(job, "Target reached after " .. job.requests .. " requests. No more rerolls sent.")
    if job.hitAction == "Rejoin" then rejoin("Target reached") end
end
local function rollbackAndRejoin(job, reason)
    local remotes = RS:FindFirstChild("rerolls")
    local keybind = remotes and remotes:FindFirstChild("KeybindChange")
    if not keybind or not keybind:IsA("RemoteEvent") then
        finish(job, "Missing rerolls.KeybindChange. Paused without rejoining.")
        return false
    end
    if not canWork(job) then finish(job, "Stopped."); return false end
    if not job.rollbackSent then
        local args = {[1] = "Right", [2] = "F\255"}
        keybind:FireServer(table.unpack(args))
        job.rollbackSent = true
    end
    setStatus(reason .. ". Keybind request sent; waiting before rejoin...")
    if not waitInterruptible(job, CONFIG.RollbackWait) then
        finish(job, "Stopped after the keybind request. Rejoin cancelled.")
        return false
    end
    local resumeKind = CONFIG.AutoResumeAfterRollback and REMOTE_NAMES[job.kind] and job.kind or nil
    local state = job.resumeState or captureSettings(resumeKind, job)
    finish(job, reason .. ". No more rerolls sent.")
    rejoin(reason .. "; keybind request sent", state)
    return false
end
manualRollback = function()
    if closed or teleporting or pendingRollback then return end
    pendingRollback = true
    closeDropdown()
    local resumeState
    if activeJob and REMOTE_NAMES[activeJob.kind] then
        local resumeKind = CONFIG.AutoResumeAfterRollback and not matches(readBuild(), activeJob) and activeJob.kind or nil
        resumeState = captureSettings(resumeKind, activeJob)
    end
    if activeJob then activeJob.cancelled = true end
    setStatus("Manual rollback queued. Waiting for any pending action to finish...")
    task.spawn(function()
        while activeJob and pendingRollback and not closed and not teleporting do task.wait(0.01) end
        if not pendingRollback or closed or teleporting then pendingRollback = false; return end
        local job = {kind = "Rollback", cancelled = false, resumeState = resumeState}
        activeJob, pendingRollback = job, false
        local ok, err = pcall(function() rollbackAndRejoin(job, "Manual rollback") end)
        if not ok then finish(job, "Manual rollback paused: " .. tostring(err)) end
    end)
end
local function floorReached(job)
    if job.slotCycle then
        setStatus("Minimum yen reached. Switching slot " .. CONFIG.SlotTarget .. " without resetting...")
        local started = sendSlot(job)
        local build, failure = waitForSlot(job, started, true)
        if not canWork(job) then finish(job, "Stopped. No further rerolls sent."); return false end
        if not build then finish(job, failure); return false end
        if matches(build, job) then targetReached(job); return false end
        setStatus("Slot refreshed; continuing " .. job.kind .. " rerolls without another reset.")
        return true
    end
    return rollbackAndRejoin(job, "Minimum yen reached")
end
startRolling = function(kind, resuming)
    if closed or teleporting then return end
    if activeJob or pendingRollback then setStatus("An action is active or pending. Stop/wait before starting another."); return end
    closeDropdown()
    local target = targets[kind] and targets[kind].get()
    if kind ~= "Buff" and kind ~= "Color" and target == nil then setStatus("Choose a " .. kind .. " target first."); return end
    if not REMOTE_NAMES[kind] then setStatus("Unknown reroll category."); return end
    local job = {
        kind = kind, target = target, faceTexture = target and (faceTextures[target] or (target == restoredFaceTarget and restoredFaceTexture)),
        buffTarget = buffTarget.get(), minimum = buffMinimum.get(), rgb = {redInput.get(), greenInput.get(), blueInput.get()},
        tolerance = toleranceInput.get(), direction = colorDirection.get(), yenFloor = yenFloor.get(),
        hitAction = usesSlotCycle(kind) and "Rejoin" or hitAction.get(),
        slotCycle = usesSlotCycle(kind), requests = 0, cancelled = false,
    }
    activeJob = job
    task.spawn(function()
        local ok, err = pcall(function()
            if not canWork(job) then finish(job, "Stopped."); return end
            local remote
            while canWork(job) do
                local folder = RS:FindFirstChild("rerolls")
                remote = folder and folder:FindFirstChild(REMOTE_NAMES[kind])
                if remote and remote:IsA("RemoteEvent") then break end
                setStatus("Waiting for " .. REMOTE_NAMES[kind] .. " to replicate; starting automatically when available...")
                task.wait(0.01)
            end
            if not canWork(job) then finish(job, "Stopped."); return end
            local initial = waitForAvailable(job)
            if not initial then finish(job, "Stopped."); return end
            if resuming and initial.yen <= job.yenFloor and not matches(initial, job) then
                local deadline = os.clock() + CONFIG.ResumeYenTimeout
                while canWork(job) and os.clock() < deadline do
                    setStatus("Resume waiting for yen above " .. job.yenFloor .. "; no rerolls sent yet...")
                    local current = readBuild()
                    if current.yen ~= nil and ready(current, kind) and (current.yen > job.yenFloor or matches(current, job)) then initial = current; break end
                    task.wait(0.01)
                end
                if not canWork(job) then finish(job, "Stopped."); return end
                if initial.yen <= job.yenFloor and not matches(initial, job) then
                    finish(job, "Yen did not recover above the minimum after rejoin. Paused to avoid repeated rejoining."); return
                end
            end
            -- Preserve an already-held target before performing any reset or switch.
            if matches(initial, job) then targetReached(job); return end
            if job.slotCycle and not prepareColor(job) then return end
            while canWork(job) do
                local before = waitForAvailable(job)
                if not before then finish(job, "Stopped."); return end
                -- Check the target before the yen floor; keep a win on the last affordable roll.
                if matches(before, job) then targetReached(job); return end
                if before.yen <= job.yenFloor then
                    if not floorReached(job) then return end
                else
                    local delay = kind == "Color" and 0 or rollDelay()
                    local started = os.clock()
                    -- Only one request is pending across all seven categories.
                    remote:FireServer()
                    job.requests, totalRequests = job.requests + 1, totalRequests + 1
                    setStatus("Rolling " .. kind .. " | request " .. job.requests .. " | waiting for the build/yen update...")
                    requestLabel.Text = "Reroll requests: " .. totalRequests
                    local after, failure = waitForResponse(before, job, started, delay)
                    if job.cancelled or not canWork(job) then finish(job, "Stopped. No further rerolls sent."); return end
                    if not after then finish(job, failure); return end
                    if matches(after, job) then targetReached(job); return end
                    if after.yen <= job.yenFloor and not floorReached(job) then return end
                end
            end
            finish(job, "Stopped.")
        end)
        if not ok then finish(job, "Roll paused: " .. tostring(err)); warn("Build Auto Roller: " .. tostring(err)) end
    end)
end

